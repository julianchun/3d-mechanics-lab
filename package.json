{
  "name": "3d-mechanics-lab",
  "version": "0.7.3",
  "description": "重訓動作的 3D 生物力學教學工具：姿勢、關節力矩、肌肉受力",
  "scripts": {
    "test": "node tests/body.mjs && node tests/validate.mjs && node tests/shoulder.mjs && node tests/plausibility.mjs && node tests/regress.mjs && node tests/trends.mjs --check && node tools/validate-sim.mjs --check",
    "dev": "vite --host",
    "prebuild": "node tests/trends.mjs --write-status",
    "build": "vite build",
    "preview": "vite preview --host --port 4173",
    "test:update": "node tests/regress.mjs --update",
    "review": "node tools/review-sheet.mjs",
    "test:trends": "node tests/trends.mjs",
    "test:validation": "node tools/validate-sim.mjs --write-status",
    "test:validation-pop": "node tools/validate-population.mjs",
    "test:heel-sweep": "node tools/validate-sim.mjs --heel-share-sweep",
    "trends:json": "node tests/trends.mjs --write-status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^6.4.6"
  }
}

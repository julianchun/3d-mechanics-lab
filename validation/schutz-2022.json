  "sourceQuality": {
    "rating": "caution",
    "reason": "同儕審查開放期刊；20 人、22 台攝影機、Kistler 測力板。上斜角度與動作指引在補充檔（未取得，未查證）；負重以體重 %（非 %1RM）；肩關節無肩胛／鎖骨節段；肩力矩只報絕對值最大值。",
    "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8877248/"
  },
  "participants": {
    "n": 20,
    "sex": "10 男、10 女",
    "training": "每週 ≥2 小時重量訓練、熟悉動作",
    "massKg": {
      "mean": 68.6,
      "sd": 11.1
    },
    "heightM": {
      "mean": 1.752,
      "sd": 0.09
    }
  },
  "protocol": "槓鈴平板與上斜臥推（槓重 10 kg 空槓加槓片）；負重 15% 與 30% 體重各六下，捨第一下；握距 = 2×上臂長＋肩寬，平均 88.7 ± 6.7 cm；逆動力學含上肢節段重，力矩除以體重。",
  "model": "bench 與 incline-bench（清單預設 30°）；握距旋鈕 2.2175 超出旋鈕上限 2.0；上斜角度與槓觸胸要求未報，故全數探索性。",
  "toleranceBasis": "探索性列的參考界線：肩力矩 0.15 Nm/kg、肘力矩 0.06 Nm/kg、肘活動範圍 15°，約研究 SD 的 2–3 倍；不進通過率。",

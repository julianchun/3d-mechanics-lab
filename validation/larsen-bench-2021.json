  "sourceQuality": {
    "rating": "caution",
    "reason": "同儕審查開放期刊；14 位男性、8 台攝影機三維捕捉＋儀器化槓（橫向力）。身高未報、關節角與力矩只在圖中；表 2 力臂的平面與合力定義文中未明述。年齡於摘要（5.4）與方法（5.2）不一致。",
    "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC7862765/"
  },
  "participants": {
    "n": 14,
    "sex": "全男",
    "training": "休閒訓練者，臥推訓練 ≥3 年；能以偏好握距臥推 ≥1.2×體重",
    "massKg": {
      "mean": 87.8,
      "sd": 18.4
    },
    "note": "身高未報，無法抽樣群體，只做固定身體。"
  },
  "protocol": "三種握距（寬 1.7×、中 1.4×、窄 1.0× 肩峰間距；平均握距 0.71／0.56／0.40 m）各做 1RM；槓觸胸可觸即推、不彈起；v0 = 上推起點（最低點），vmin = 第一個最低速度（黏滯點）。",
  "model": "寬、中握用 bench，窄握用 cg-bench；握距旋鈕 = 平均握距 m／0.4（模型握點間距 = 0.4×旋鈕）；槓垂直位移取模型頂點至觸胸；力臂取模型槓力（垂直）在前臂—上臂平面內的垂直距離。",
  "toleranceBasis": "位移 0.05 m（垂直）與 0.04 m（水平），約研究 SD 一倍；力臂 0.04 m，研究 SD 0.02–0.05 m。",
